# Railway service settings. Store values in Railway; do not commit secrets.
LIFE_OS_DATABASE=/data/life_os.db
LIFE_OS_PROFILE=/data/private/profile.toml
LIFE_OS_BRIEFINGS_DIR=/data/private/briefings
LIFE_OS_APPOINTMENT_LEDGER=/data/private/appointment-ledger.json
LIFE_OS_GMAIL_ACCOUNTS=/data/private/gmail-accounts.json
LIFE_OS_HEALTH_INGEST_TOKEN_PATH=/data/private/apple-health-ingest-token.txt
OURA_TOKEN_PATH=/data/private/oura-token.json
WHOOP_TOKEN_PATH=/data/private/whoop-token.json
LIFE_OS_TIMEZONE=America/Los_Angeles
LIFE_OS_MODEL=gpt-5.6-luna

# Railway volumes are mounted as root. This lets the service write to /data.
RAILWAY_RUN_UID=0

# Secrets: generate or copy these only into Railway's encrypted environment.
LIFE_OS_API_TOKEN=
OPENAI_API_KEY=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://your-api.example.com/v1/integrations/whoop/callback
WHOOP_RETURN_URL=https://your-private-site.example.com/
